# Copy to vouch/backend/.env and fill in.
# Leave MOCK_MODE=true to run the whole app offline against fixtures.
#
# THIS FILE IS COMMITTED. Never put a real secret here - put it in vouch/backend/.env,
# which .gitignore covers.

MOCK_MODE=true

# Required only when MOCK_MODE=false.
# The Bright Data CLI reads BRIGHTDATA_API_KEY; the Python SDK reads BRIGHTDATA_API_TOKEN.
# Set both to the same value, or just run `npx -y @brightdata/cli login`.
BRIGHTDATA_API_KEY=
BRIGHTDATA_API_TOKEN=

# Required only for the Tier-3 LLM judge.
ANTHROPIC_API_KEY=
LLM_JUDGE_MODEL=claude-sonnet-4-6
