# Copy to .env and fill in. Leave MOCK_MODE=true to run the whole app offline against fixtures.

MOCK_MODE=true
DATABASE_URL=sqlite:///vouch.db

# Required only when MOCK_MODE=false
BRIGHTDATA_API_TOKEN=

# Required only for the Tier-3 LLM judge (Phase 3)
ANTHROPIC_API_KEY=
LLM_JUDGE_MODEL=claude-sonnet-4-6
