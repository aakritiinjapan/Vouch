# Copy to vouch/backend/.env and fill in. Nothing here is required to run the demo.
#
# THIS FILE IS COMMITTED. Never put a real secret here - put it in vouch/backend/.env,
# which .gitignore covers.

# Replay a stored dataset instead of calling Bright Data. Leave true to run the whole app offline.
MOCK_MODE=true

# Which dataset MOCK_MODE replays, by basename under vouch/backend/tests/fixtures/.
#
#   newegg_live  (default) derived from the real 96-row run of collector c_mszq0z1x27brru3wab.
#                Regenerate with: cd vouch/backend && python -m scripts.build_demo_fixture
#   sample_runs  the smaller hand-written set. It also carries original_price, which the live
#                collector never captured, so it is the only one that can replay the
#                VALUE_ORDER_INVERTED scenario. The test suite pins itself to this one.
DEMO_DATASET=newegg_live

# Required only when MOCK_MODE=false.
# The Bright Data CLI reads BRIGHTDATA_API_KEY; the Python SDK reads BRIGHTDATA_API_TOKEN.
# Set both to the same value, or just run `npx -y @brightdata/cli login`.
BRIGHTDATA_API_KEY=
BRIGHTDATA_API_TOKEN=

# Required only for the Tier-3 LLM judge. Without it the judge short-circuits and the
# deterministic tiers stand on their own.
ANTHROPIC_API_KEY=
LLM_JUDGE_MODEL=claude-sonnet-4-6
