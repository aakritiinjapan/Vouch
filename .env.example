# Copy this file to .env and fill in the values you need.
# The app runs fully offline by default (MOCK_MODE=true) - only set keys when going live.

# ── Core ────────────────────────────────────────────────────────────────────────

# Set to false to run against real Bright Data collectors and the live Anthropic judge.
MOCK_MODE=true

# Which fixture the demo replays. Options: newegg_live | sample_runs
DEMO_DATASET=newegg_live

# ── Optional API key guard ───────────────────────────────────────────────────────
# When set, all mutating endpoints (approve, reject, reset, cycles/run) require the header:
#   X-API-Key: <value>
# Leave empty to keep the open demo mode (safe when MOCK_MODE=true and not publicly deployed).
API_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed by CORS.
# Defaults to localhost dev servers when this variable is unset.
# ALLOWED_ORIGINS=https://your-deployed-frontend.example.com

# ── Bright Data ─────────────────────────────────────────────────────────────────
# Required when MOCK_MODE=false.
# brightdata_api_key  -> the @brightdata/cli (drives heal / approve / reject loops)
# brightdata_api_token -> the Python SDK (runs collectors)
# Set whichever surface you use; the CLI also reads its own credential store after `brightdata login`.
BRIGHTDATA_API_KEY=
BRIGHTDATA_API_TOKEN=

# ── Anthropic (Tier 3 LLM judge) ────────────────────────────────────────────────
# Required only when use_judge=true is passed to POST /verify.
ANTHROPIC_API_KEY=

# Model used by the Tier 3 judge. Defaults to claude-sonnet-4-6.
# LLM_JUDGE_MODEL=claude-sonnet-4-6

# ── Database ────────────────────────────────────────────────────────────────────
# Defaults to vouch/backend/vouch.db (anchored to the file location, not cwd).
# Override only if you need a non-default path.
# DATABASE_URL=sqlite:////absolute/path/to/vouch.db
